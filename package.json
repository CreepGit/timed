{
  "name": "timed",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "build": "tsc && cp -R src/styles.css src/vendor dist/",
    "start": "node --env-file=.env dist/index.js",
    "typecheck": "tsc --noEmit",
    "typegen": "pocketbase-typegen --out src/pocketbase-types.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.12",
    "hono": "^4.12.34",
    "pocketbase": "^0.27.1"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "pocketbase-typegen": "^1.5.0",
    "tsx": "^4.23.0",
    "typescript": "^7.0.2"
  }
}