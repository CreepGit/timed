# PocketBase instance backing the app.
PB_HOST=https://pbdb.example.com

# Superuser token. Every read and write the server makes uses it, so the app is
# fully trusted against the database -- keep it out of the browser and out of git.
PB_TOKEN=

# Port to listen on. Optional, defaults to 3000.
# PORT=3000

# Used only by `pnpm typegen`, which reads this file itself. The server does not
# need these to start.
PB_TYPEGEN_URL=https://pbdb.example.com
PB_TYPEGEN_TOKEN=
